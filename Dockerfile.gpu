# MolForge — GPU image for Azure Container Apps SERVERLESS GPU (scale-to-zero) or a GPU VM.
# Bakes the staged ./artifacts bundle (run deploy_prepare.ps1 first). Generation that takes
# minutes on CPU runs in ~10-20 s here.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3-pip libxrender1 libxext6 libsm6 \
    && rm -rf /var/lib/apt/lists/* && ln -sf /usr/bin/python3.11 /usr/bin/python

WORKDIR /app/molvae

# CUDA 12.4 torch first (layer-caches), then the rest.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124 \
 && pip install --no-cache-dir rdkit selfies numpy tqdm pandas scikit-learn joblib \
        "fastapi>=0.110" "uvicorn[standard]>=0.29" "python-multipart>=0.0.9" \
        "openai>=1.40" "python-dotenv>=1.0"

COPY . /app/molvae

ENV MOLVAE_ART_DIR=/app/molvae/artifacts \
    MOLVAE_DEVICE=cuda \
    MOLVAE_CKPT=/app/molvae/artifacts/checkpoints/best.pt \
    PORT=8000
EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
