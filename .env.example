# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your keys, OR set these as real
# environment variables. They are ONLY used by the optional LLM helper
# (molvae/llm.py) that turns a natural-language request into a property spec.
# The VAE training / generation / xTB pipeline does NOT need any of these.
# ---------------------------------------------------------------------------

# Azure AI Foundry  (DeepSeek-V4-Pro "reasoner", Kimi-K2.6 "fast", embeddings)
FOUNDRY_API_KEY=your-foundry-key-here
FOUNDRY_ENDPOINT=https://zincbatteryresearch.services.ai.azure.com/openai/v1

# Azure OpenAI  (gpt-5.x deployment used as the "judge")
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://batterymlresearch.openai.azure.com/openai/v1

# ---------------------------------------------------------------------------
# Optional overrides for the rest of the pipeline (defaults live in config.py)
# ---------------------------------------------------------------------------
# XTB_EXE=C:\Users\nkapa\Downloads\xtb-6.7.1pre-windows-x86_64\xtb-6.7.1\bin\xtb.exe
# MOLVAE_ART_DIR=D:\molvae_artifacts          # put big artifacts on another drive
# MOLVAE_BATCH=256                            # lower to 128 if you hit CUDA OOM
# MOLVAE_CKPT_EVERY=500000                    # checkpoint every N molecules
# MOLVAE_WORKERS=11                           # CPU procs for preprocessing
