# molvae generative designer — CPU image for a public demo (Azure Container Apps).
# Artifacts are BAKED in (staged at ./artifacts by deploy_prepare.ps1) so there is no
# Azure Files mount to configure — simplest path to a working URL.
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxrender1 libxext6 libsm6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/molvae

# CPU torch wheel (much smaller than the CUDA build) + the light deps.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir rdkit selfies numpy tqdm pandas scikit-learn joblib \
        "fastapi>=0.110" "uvicorn[standard]>=0.29" "python-multipart>=0.0.9" \
        "openai>=1.40" "python-dotenv>=1.0"

# code + the staged minimal artifacts bundle (./artifacts)
COPY . /app/molvae

ENV MOLVAE_ART_DIR=/app/molvae/artifacts \
    MOLVAE_DEVICE=cpu \
    MOLVAE_CKPT=/app/molvae/artifacts/checkpoints/best.pt \
    PORT=8000
EXPOSE 8000

# 1 worker = 1 model copy in RAM. Scale with Container App replicas, not workers.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
